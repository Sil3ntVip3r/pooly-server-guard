# Pooly Server Guard environment example
# Copy to /etc/pooly/server-guard.env on each server.
# Keep the real file private and never commit actual webhook/API keys.

POOLY_DISCORD_ENABLED=0
POOLY_DISCORD_WEBHOOK=""
POOLY_ALERT_ON_PASS=0
POOLY_WATCH_WARN_UPDATES=0
POOLY_WATCH_WARN_REBOOT=1
POOLY_WATCH_WARN_UFW_DRIFT=1

# Observe-only virtio memory-balloon monitoring.
# Disabled by default. Phase 1 never changes swap, services, kernel settings,
# or systemd state. Enable only on an approved canary node first.
POOLY_BALLOON_MONITOR_ENABLED=0
POOLY_BALLOON_WARN_MIB=1024
POOLY_BALLOON_HISTORY_MAX_LINES=10000
POOLY_BALLOON_LOCK_WAIT_SECONDS=2
